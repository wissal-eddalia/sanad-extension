{
  "manifest_version": 3,
  "name": "Sanad — Verify Any Claim",
  "version": "0.1.0",
  "description": "Highlight any claim on the web and verify it in place, with sourced evidence and a media-literacy tip.",
  "icons": {
    "16": "public/icons/icon16.png",
    "48": "public/icons/icon48.png",
    "128": "public/icons/icon128.png"
  },
  "action": {
    "default_title": "Sanad",
    "default_icon": {
      "16": "public/icons/icon16.png",
      "48": "public/icons/icon48.png",
      "128": "public/icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/content.ts"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "permissions": ["contextMenus", "activeTab", "sidePanel", "scripting", "storage"],
  "host_permissions": ["http://localhost:8000/*"]
}
